{
  "name": "codex-pet-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny Electron desktop overlay for Codex-style pets.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-static.ps1",
    "install:local-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-cache.ps1",
    "start": "npm run build && electron .",
    "start:scopey": "npm run build && electron . --pet=scopey",
    "start:vera-reviewer": "npm run build && electron . --pet=vera-reviewer",
    "check": "npm run build",
    "smoke": "npm run build && electron . --smoke-test",
    "validate:pets": "npm run build && electron . --validate-pets"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "electron": "^42.0.1",
    "typescript": "^6.0.3"
  }
}
